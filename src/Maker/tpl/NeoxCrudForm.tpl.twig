{#
  Compute base layout safely:
  - prefer twig_base_layout when provided
  - else if templates_namespace is provided, build @<ns>/admin/_layout.html.twig
  - else fallback to '/admin/_layout.html.twig'
  Use `is defined` to avoid runtime errors when variables are absent.
  The maker passes a `twig_base_layout` option when available.
#}
{%- if twig_base_layout is defined and twig_base_layout is not empty -%}
    {%- set base_layout = twig_base_layout -%}
{%- elseif templates_namespace is defined and templates_namespace is not empty -%}
    {%- set base_layout = '@' ~ templates_namespace ~ '/admin/_layout.html.twig' -%}
{%- else -%}
    {%- set base_layout = 'Admin/Partial/_layout-administrator.html.twig' -%}
{%- endif -%}

{% extends base_layout %}

{% block content %}
  <h1>
    {% if entity.id %}
      {% set __edit_key = resource ~ '.title.edit' %}
      {% set __edit_val = __edit_key|trans({}, resource) %}
      {{ __edit_val != __edit_key ? (__edit_val ~ ' #' ~ entity.id) : ('Modifier ' ~ resource|capitalize ~ ' #' ~ entity.id) }}
    {% else %}
      {% set __new_key = resource ~ '.title.new' %}
      {% set __new_val = __new_key|trans({}, resource) %}
      {{ __new_val != __new_key ? __new_val : ('Nouveau ' ~ resource|capitalize) }}
    {% endif %}
  </h1>

  {{ form_start(form) }}
    {% for child in form %}
      {% if child.vars.block_prefixes is defined and 'collection' in child.vars.block_prefixes %}
        {# CollectionType #}
        <div class="mb-3">
          {{ form_label(child) }}
          {{ form_errors(child) }}
          {# Check if this collection uses live_component #}
          {% set field_name = child.vars.name %}
          {% set use_live_component = false %}
          {% for field in form_fields %}
            {% if field.name == field_name and field.live_component is defined and field.live_component %}
              {% set use_live_component = true %}
            {% endif %}
          {% endfor %}
          {% if use_live_component %}
            {{ component('neox_crud.collection_live', { form: child }) }}
          {% else %}
            <div class="collection-container">
              {{ form_widget(child) }}
            </div>
          {% endif %}
        </div>
      {% else %}
        <div class="mb-3">
          {{ form_label(child) }}
          {{ form_widget(child) }}
          {{ form_errors(child) }}
          {{ form_help(child) }}
        </div>
      {% endif %}
    {% endfor %}

    <button class="btn btn-primary">
      {{ 'Enregistrer' }}
    </button>

    <a href="{{ path('neox_crud_admin_crud_index', { resource: resource }) }}" class="btn btn-secondary">
      Retour à la liste
    </a>
  {{ form_end(form) }}
{% endblock %}
