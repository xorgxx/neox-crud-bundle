{% extends 'base.html.twig' %}

{% block content %}
  <div class="container mt-4">
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ label }} mb-2">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    {% block admin_content '' %}
  </div>
{% endblock %}
