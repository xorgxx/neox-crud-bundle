{% extends 'admin/_layout.html.twig' %}

{% block admin_content %}
  <h1>Produits</h1>

  <div class="d-flex gap-2 align-items-center mb-3">
    <a href="{{ path('neox_crud_admin_crud_new', { resource: 'product' }) }}" class="btn btn-primary">
      Nouveau produit
    </a>
    {% if toolbarButtons is defined and toolbarButtons is not empty %}
      {% for btn in toolbarButtons %}
        {% set isGet = (btn.method|default('GET')|upper) == 'GET' %}
        {% if btn.route is defined and btn.route %}
          {% set params = (btn.params|default({})) %}
          {% set url = path(btn.route, params|merge({ resource: resource })) %}
        {% elseif btn.path is defined and btn.path %}
          {% set url = btn.path %}
        {% else %}
          {% set url = '#' %}
        {% endif %}
        {% if isGet %}
          <a href="{{ url }}" class="btn btn-sm {{ btn.class|default('btn-outline-secondary') }}" title="{{ btn.label }}">
            {% if btn.icon %}<i class="{{ btn.icon }}"></i>{% endif %} {{ btn.label }}
          </a>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nom</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
    {% for item in items %}
      <tr>
        <td>{{ item.id }}</td>
        <td>{{ item.name ?? 'N/A' }}</td>
        <td>
          {% set actions = (rowActionsById is defined and rowActionsById[item.id] is defined) ? rowActionsById[item.id] : [] %}
          {% if actions is not empty %}
            {% for a in actions %}
              {% set isGet = (a.method|default('GET')|upper) == 'GET' %}
              {% if a.route is defined and a.route %}
                {% set params = (a.params|default({})) %}
                {% set url = path(a.route, params|merge({ resource: resource })) %}
              {% elseif a.path is defined and a.path %}
                {% set url = a.path %}
              {% else %}
                {% set url = '#' %}
              {% endif %}

              {% if isGet %}
                <a href="{{ url }}" class="btn btn-sm {{ a.class|default('btn-outline-secondary') }}" title="{{ a.label }}">
                  {% if a.icon %}<i class="{{ a.icon }}"></i>{% endif %} {{ a.label }}
                </a>
              {% else %}
                {# Securely handle known routes with CSRF #}
                {% if a.route == 'neox_crud_admin_crud_delete' %}
                  <form method="post" action="{{ url }}" style="display:inline-block" onsubmit="return {{ a.confirm ? 'confirm(\'' ~ a.confirm ~ '\')' : 'true' }};">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ item.id) }}">
                    <button class="btn btn-sm {{ a.class|default('btn-danger') }}">{% if a.icon %}<i class="{{ a.icon }}"></i>{% endif %} {{ a.label }}</button>
                  </form>
                {% elseif a.route == 'neox_crud_admin_crud_custom' and a.params.action is defined %}
                  <form method="post" action="{{ url }}" style="display:inline-block" onsubmit="return {{ a.confirm ? 'confirm(\'' ~ a.confirm ~ '\')' : 'true' }};">
                    <input type="hidden" name="_token" value="{{ csrf_token('custom_' ~ resource ~ '_' ~ item.id ~ '_' ~ a.params.action) }}">
                    <button class="btn btn-sm {{ a.class|default('btn-secondary') }}">{% if a.icon %}<i class="{{ a.icon }}"></i>{% endif %} {{ a.label }}</button>
                  </form>
                {% else %}
                  {# Unknown non-GET route: render as disabled button to avoid insecure POST #}
                  <button class="btn btn-sm {{ a.class|default('btn-outline-secondary') }}" disabled title="{{ a.label }}">{% if a.icon %}<i class="{{ a.icon }}"></i>{% endif %} {{ a.label }}</button>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% else %}
            <a href="{{ path('neox_crud_admin_crud_edit', { resource: 'product', id: item.id }) }}" class="btn btn-sm btn-secondary">Éditer</a>
            <form method="post" action="{{ path('neox_crud_admin_crud_delete', { resource: 'product', id: item.id }) }}" style="display:inline-block" onsubmit="return confirm('Confirmer la suppression ?');">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ item.id) }}">
              <button class="btn btn-sm btn-danger">Supprimer</button>
            </form>
          {% endif %}
        </td>
      </tr>
    {% else %}
      <tr>
        <td colspan="3">Aucun produit.</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
{% endblock %}
