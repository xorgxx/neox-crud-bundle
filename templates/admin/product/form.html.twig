{% extends 'admin/_layout.html.twig' %}

{% block admin_content %}
  <h1>
    {% if entity.id %}
      Modifier le produit #{{ entity.id }}
    {% else %}
      Nouveau produit
    {% endif %}
  </h1>

  {{ form_start(form) }}
    {{ form_widget(form) }}

    <button class="btn btn-primary">
      Enregistrer
    </button>

    <a href="{{ path('neox_crud_admin_crud_index', { resource: 'product' }) }}" class="btn btn-secondary">
      Retour à la liste
    </a>
  {{ form_end(form) }}
{% endblock %}
