{% use "bootstrap_5_layout.html.twig" %}

{# Surcharge de form_row pour aligner les labels à gauche #}
{% block form_row %}
    {% set row_attr = row_attr|merge({ class: row_attr.class|default('mb-3') ~ ' text-start' }) %}
    {{ parent() }}
{% endblock %}

{# Surcharge de form_label pour aligner à gauche #}
{% block form_label %}
    {% set label_attr = label_attr|merge({ class: label_attr.class|default('form-label') ~ ' text-start' }) %}
    {{ parent() }}
{% endblock %}

{# Surcharge de form_widget pour aligner à gauche #}
{% block form_widget_simple %}
    {% set attr = attr|merge({ class: attr.class|default('form-control') ~ ' text-start' }) %}
    {{ parent() }}
{% endblock %}

{# Surcharge de textarea #}
{% block textarea_widget %}
    {% set attr = attr|merge({ class: attr.class|default('form-control') ~ ' text-start' }) %}
    {{ parent() }}
{% endblock %}

{# Surcharge de select #}
{% block choice_widget_collapsed %}
    {% set attr = attr|merge({ class: attr.class|default('form-select') ~ ' text-start' }) %}
    {{ parent() }}
{% endblock %}

{# Surcharge de form_help pour ne pas afficher si null ou vide #}
{% block form_help %}
    {% if help is not null and help is not empty %}
        {{ parent() }}
    {% endif %}
{% endblock %}
