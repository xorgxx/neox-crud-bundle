{% import '@NeoxCrud/macros/cell_renderers.html.twig' as renderer %}

{% set pager = this.pager %}
{% set columns = this.columns %}
{% set toolbarButtons = this.toolbarButtons %}
{% set rowActionsById = this.rowActionsById %}
{% set bulkActions = this.bulkActions %}

{% set hasSearch = false %}
{% for col in columns %}
  {% if col.searchable|default(false) %}
    {% set hasSearch = true %}
  {% endif %}
{% endfor %}

{% set paginationPosition = this.paginationPosition|default('bottom') %}

<div {{ attributes }}>
  <div class="mb-2 fw-semibold"><h1>Manager {{ resource|replace({'_':' '})|title }}</h1></div>

  <div class="card">
    <div class="card-header py-2">
      <div class="p-3">
      <div class="d-flex gap-2 align-items-center">
        <div style="max-width: 280px; width: 100%;">
          {% if hasSearch %}
            <div class="d-flex align-items-center gap-2">
              <div class="input-group input-group-sm w-100">
                <span class="input-group-text">
                  <span data-loading="model(search)|hide">🔍</span>
                  <span data-loading="model(search)|delay(150)|show" style="display:none" class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                </span>
                <input
                  type="search"
                  class="form-control"
                  placeholder="Search..."
                  data-model="on(input)|debounce(1200)|search"
                >
                <button
                  type="button"
                  class="btn btn-outline-secondary"
                  title="Clear"
                  data-action="live#action"
                  data-live-action-param="clearSearch"
                  {% if this.search is empty %}disabled{% endif %}
                >
                  ✕
                </button>
              </div>

              {% set filtered = this.filteredCount %}
              {% set total = this.totalCount %}
              {% if total > 0 and filtered != total %}
                <small class="text-muted text-nowrap">{{ filtered }} / {{ total }}</small>
              {% elseif total > 0 %}
                <small class="text-muted text-nowrap">{{ total }}</small>
              {% endif %}
            </div>
          {% else %}
            <small class="text-muted">No search set</small>
          {% endif %}
        </div>

        <div class="d-flex gap-2 align-items-center ms-auto">
          {% if bulkActions is defined and bulkActions is not empty %}
            <div class="d-flex gap-2 align-items-center">
              {% if this.selectionCount > 0 %}
                <span class="badge text-bg-secondary">{{ this.selectionCount }}</span>
              {% endif %}
              <button
                type="button"
                class="btn btn-sm btn-outline-secondary"
                data-action="live#action"
                data-live-action-param="selectAllCurrentPage"
              >
                Select page
              </button>
              <button
                type="button"
                class="btn btn-sm btn-outline-secondary"
                data-action="live#action"
                data-live-action-param="clearSelection"
                {% if this.selectionCount == 0 %}disabled{% endif %}
              >
                Clear
              </button>
            </div>
          {% endif %}

          <a
            href="{{ path('neox_crud_admin_crud_new', { resource: resource, _modal: 1 }) }}"
            class="btn btn-sm btn-primary"
            data-neox-crud-modal
            data-neox-crud-modal-title="Nouveau"
          >
            {% set __new_key = resource ~ '.action.new' %}
            {% set __new_val = __new_key|trans({}, resource) %}
            {{ __new_val != __new_key ? __new_val : 'Nouveau' }}
          </a>
          {% if toolbarButtons is defined and toolbarButtons is not empty %}
            {% for btn in toolbarButtons %}
              {% set isGet = (btn.method|default('GET')|upper) == 'GET' %}
              {% if btn.route is defined and btn.route %}
                {% set params = (btn.params|default({})) %}
                {% set url = path(btn.route, params|merge({ resource: resource })) %}
              {% elseif btn.path is defined and btn.path %}
                {% set url = btn.path %}
              {% else %}
                {% set url = '#' %}
              {% endif %}
              {% if isGet %}
                <a
                  href="{{ url }}"
                  class="btn btn-sm {{ btn.class|default('btn-outline-secondary') }}"
                  title="{{ btn.label }}"
                >
                  {% if btn.icon %}<i class="{{ btn.icon }}"></i>{% endif %} {{ btn.label }}
                </a>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>
      </div>
    </div>

    <div class="card-body">

{% if bulkActions is defined and bulkActions is not empty %}
  <div class="d-flex gap-2 align-items-center mb-3">
    {% for a in bulkActions %}
      {% set isGet = (a.method|default('GET')|upper) == 'GET' %}

      {% if a.route is defined and a.route %}
        {% set params = (a.params|default({})) %}
        {% set url = path(a.route, params|merge({ resource: resource, id: 0 })) %}
      {% elseif a.path is defined and a.path %}
        {% set url = a.path %}
      {% else %}
        {% set url = '#' %}
      {% endif %}

      {% if isGet %}
        <a
          href="{{ url }}"
          class="btn btn-sm {{ a.class|default('btn-outline-secondary') }}"
          title="{{ a.label }}"
        >
          {% if a.icon %}<i class="{{ a.icon }}"></i>{% endif %} {{ a.label }}
        </a>
      {% else %}
        <form
          method="post"
          action="{{ url }}"
          style="display:inline-block"
          onsubmit="return {{ (a.confirm is defined and a.confirm) ? 'confirm(\'' ~ a.confirm ~ '\')' : 'true' }};"
        >
          {% if a.route == 'neox_crud_admin_crud_custom' and a.params.action is defined %}
            <input type="hidden" name="_token" value="{{ csrf_token('custom_' ~ resource ~ '_0_' ~ a.params.action) }}">
          {% endif %}
          <input type="hidden" name="ids" value="{{ this.selectedIds|json_encode }}">
          <button class="btn btn-sm {{ a.class|default('btn-secondary') }}" data-label="{{ a.label }}" {% if a.selection_required|default(true) and this.selectionCount == 0 %}disabled{% endif %}>
            {% if a.icon %}<i class="{{ a.icon }}"></i>{% endif %} {{ a.label }}
          </button>
        </form>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

{% set hasFilters = false %}
{% for col in columns %}
  {% if col.filter is defined and col.filter is not empty %}
    {% set hasFilters = true %}
  {% endif %}
{% endfor %}

{% if hasFilters %}
  <div class="card card-body mb-3">
    <div class="row g-2 align-items-end">
      {% for col in columns %}
        {% set f = col.filter|default(null) %}
        {% if f is not empty %}
          {% set t = f.type|default(null) %}
          {% if t is defined and t is not empty %}
            {% if t == 'boolean' %}
              <div class="col-auto" style="min-width: 180px;">
                <label class="form-label form-label-sm">{{ col.label }}</label>
                <select
                  class="form-select form-select-sm"
                  data-model="on(change)|filters[{{ col.name }}]"
                >
                  <option value="">All</option>
                  <option value="1" {% if (this.filters[col.name]|default('')) == '1' %}selected{% endif %}>Yes</option>
                  <option value="0" {% if (this.filters[col.name]|default('')) == '0' %}selected{% endif %}>No</option>
                </select>
              </div>
            {% elseif t == 'choice' %}
              <div class="col-auto" style="min-width: 220px;">
                <label class="form-label form-label-sm">{{ col.label }}</label>
                <select
                  class="form-select form-select-sm"
                  data-model="on(change)|filters[{{ col.name }}]"
                >
                  <option value="">All</option>
                  {% set choices = f.choices|default({}) %}
                  {% for choiceLabel, choiceValue in choices %}
                    <option value="{{ choiceValue }}" {% if (this.filters[col.name]|default('')) == (choiceValue ~ '') %}selected{% endif %}>{{ choiceLabel }}</option>
                  {% endfor %}
                </select>
              </div>
            {% elseif t == 'date' %}
              <div class="col-auto" style="min-width: 320px;">
                <label class="form-label form-label-sm">{{ col.label }}</label>
                <div class="d-flex gap-2">
                  <input
                    type="date"
                    class="form-control form-control-sm"
                    value="{{ this.filters[col.name].from|default('') }}"
                    data-model="on(change)|filters[{{ col.name }}][from]"
                  >
                  <input
                    type="date"
                    class="form-control form-control-sm"
                    value="{{ this.filters[col.name].to|default('') }}"
                    data-model="on(change)|filters[{{ col.name }}][to]"
                  >
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% if pager.nbPages > 1 and (paginationPosition == 'top' or paginationPosition == 'all') %}
  <div class="d-flex justify-content-end mb-2">
    <nav>
      <ul class="pagination mb-0">
        {% for p in 1..pager.nbPages %}
          <li class="page-item {{ p == pager.currentPage ? 'active' : '' }}">
            <button
              type="button"
              class="page-link"
              data-action="live#action"
              data-live-action-param="goToPage"
              data-live-page-param="{{ p }}"
            >
              {{ p }}
            </button>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
{% endif %}

<table class="table table-striped">
  <thead>
    <tr>
      {% if bulkActions is defined and bulkActions is not empty %}
        <th style="width: 1%;">
          <input type="checkbox" class="form-check-input" disabled>
        </th>
      {% endif %}
      {% for col in columns %}
        {% set voters = col.options.voters|default(null) %}
        {% set granted = true %}
        {% if voters is not null %}
          {% for v in voters %}
            {% if not is_granted(v) %}
              {% set granted = false %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if granted %}
          <th class="text-start pe-3">
            {% if col.sortable %}
              <button
                type="button"
                class="p-0 border-0 bg-transparent text-body text-decoration-none d-flex align-items-center justify-content-between w-100"
                style="font: inherit; line-height: inherit;"
                data-action="live#action"
                data-live-action-param="sortBy"
                data-live-field-param="{{ col.name }}"
              >
                <span>{{ col.label }}</span>
                <span class="text-muted ms-2">
                  {% if this.sort == col.name %}
                    {% if this.direction == 'asc' %}▲{% else %}▼{% endif %}
                  {% else %}
                    ↕
                  {% endif %}
                  {% if col.filter is defined and col.filter is not empty %}
                    <span class="ms-1">▾</span>
                  {% endif %}
                </span>
              </button>
            {% else %}
              <div class="d-flex align-items-center justify-content-between">
                <span>{{ col.label }}</span>
                {% if col.filter is defined and col.filter is not empty %}
                  <span class="text-muted ms-2">▾</span>
                {% endif %}
              </div>
            {% endif %}
          </th>
        {% endif %}
      {% endfor %}
      <th class="text-start" style="width: 1%; white-space: nowrap;">Actions</th>
    </tr>
  </thead>
  <tbody>
  {% for item in pager.currentPageResults %}
    <tr>
      {% set id = attribute(item, 'id') %}
      {% set idKey = id ~ '' %}
      {% if bulkActions is defined and bulkActions is not empty %}
        <td>
          <input type="checkbox" class="form-check-input" value="{{ id }}" data-model="selectedIds[]">
        </td>
      {% endif %}
      {% for col in columns %}
        {% set voters = col.options.voters|default(null) %}
        {% set granted = true %}
        {% if voters is not null %}
          {% for v in voters %}
            {% if not is_granted(v) %}
              {% set granted = false %}
            {% endif %}
          {% endfor %}
        {% endif %}

{#        {% if granted %}#}
{#          {% set value = attribute(item, col.name) %}#}

{#            <td class="text-start pe-3">#}
{#                {{ renderer.render_cell(value, col.options) }}#}
{#            </td>#}
{#        {% endif %}#}
          {% if granted %}
              {% set value = attribute(item, col.name) %}
              {% if col.query_path is defined and col.query_path is not empty %}
                  {% set pathParts = col.query_path|split('.') %}
                  {% for part in pathParts|slice(1) %}  {# Ignorer le premier segment #}
                      {% set value = attribute(value, part) %}
                  {% endfor %}
              {% endif %}

              <td class="text-start pe-3">
                  {{ renderer.render_cell(value, col.options) }}
              </td>
          {% endif %}
      {% endfor %}

      <td class="align-middle text-end" style="width: 1%; white-space: nowrap;">
        {% set actions = (rowActionsById is defined and rowActionsById[idKey] is defined) ? rowActionsById[idKey] : [] %}
        <div class="d-inline-flex gap-1 align-items-center justify-content-end flex-nowrap">
          {% if actions is not empty %}
            {% for a in actions %}
              {% set isGet = (a.method|default('GET')|upper) == 'GET' %}
              {% if a.route is defined and a.route %}
                {% set params = (a.params|default({})) %}
                {% set url = path(a.route, params|merge({ resource: resource })) %}
              {% elseif a.path is defined and a.path %}
                {% set url = a.path %}
              {% else %}
                {% set url = '#' %}
              {% endif %}

              {% if isGet %}
                <a
                  href="{{ url }}"
                  class="btn btn-sm {{ a.class|default('btn-outline-secondary') }}"
                  title="{{ a.label }}"
                  data-neox-crud-modal
                  data-neox-crud-modal-title="{{ a.label }}"
                >
                  {% if a.icon %}<i class="{{ a.icon }}"></i>{% endif %} {{ a.label }}
                </a>
              {% else %}
                {% if a.route == 'neox_crud_admin_crud_delete' %}
                  <form
                    method="post"
                    action="{{ url }}"
                    data-neox-crud-ajax-delete
                    style="display:inline-flex; margin:0; align-items:center"
                    onsubmit="return {{ (a.confirm is defined and a.confirm) ? 'confirm(\'' ~ a.confirm ~ '\')' : 'true' }};"
                  >
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ id) }}">
                    <button class="btn btn-sm {{ a.class|default('btn-danger') }}" data-label="{{ a.label }}">{% if a.icon %}<i class="{{ a.icon }}"></i>{% endif %} {{ a.label }}</button>
                  </form>
                {% elseif a.route == 'neox_crud_admin_crud_custom' and a.params.action is defined %}
                  <form
                    method="post"
                    action="{{ url }}"
                    style="display:inline-flex; margin:0; align-items:center"
                    onsubmit="return {{ (a.confirm is defined and a.confirm) ? 'confirm(\'' ~ a.confirm ~ '\')' : 'true' }};"
                  >
                    <input type="hidden" name="_token" value="{{ csrf_token('custom_' ~ resource ~ '_' ~ id ~ '_' ~ a.params.action) }}">
                    <button class="btn btn-sm {{ a.class|default('btn-secondary') }}" data-label="{{ a.label }}">{% if a.icon %}<i class="{{ a.icon }}"></i>{% endif %} {{ a.label }}</button>
                  </form>
                {% else %}
                  <button class="btn btn-sm {{ a.class|default('btn-outline-secondary') }}" disabled title="{{ a.label }}">{% if a.icon %}<i class="{{ a.icon }}"></i>{% endif %} {{ a.label }}</button>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% else %}
            <a
              href="{{ path('neox_crud_admin_crud_edit', { resource: resource, id: id, _modal: 1 }) }}"
              class="btn btn-sm btn-secondary"
              data-neox-crud-modal
              data-neox-crud-modal-title="Éditer"
            >
              {% set __edit_key = resource ~ '.action.edit' %}
              {% set __edit_val = __edit_key|trans({}, resource) %}
              {{ __edit_val != __edit_key ? __edit_val : 'Éditer' }}
            </a>
            <form method="post"
                  action="{{ path('neox_crud_admin_crud_delete', { resource: resource, id: id }) }}"
                  data-neox-crud-ajax-delete
                  style="display:inline-flex; margin:0; align-items:center"
                  onsubmit="return confirm('Confirmer la suppression ?');">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ idKey) }}">
              <button class="btn btn-sm btn-danger">
                {% set __del_key = resource ~ '.action.delete' %}
                {% set __del_val = __del_key|trans({}, resource) %}
                {{ __del_val != __del_key ? __del_val : 'Supprimer' }}
              </button>
            </form>
          {% endif %}
        </div>
      </td>
    </tr>
  {% else %}
    <tr>
      <td colspan="{{ columns|length + ((bulkActions is defined and bulkActions is not empty) ? 1 : 0) }}">Aucun élément.</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{% if pager.nbPages > 1 and (paginationPosition == 'bottom' or paginationPosition == 'all') %}
  <div class="d-flex justify-content-end mt-2">
    <nav>
      <ul class="pagination mb-0">
        {% for p in 1..pager.nbPages %}
          <li class="page-item {{ p == pager.currentPage ? 'active' : '' }}">
            <button
              type="button"
              class="page-link"
              data-action="live#action"
              data-live-action-param="goToPage"
              data-live-page-param="{{ p }}"
            >
              {{ p }}
            </button>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
{% endif %}

    </div>
    <div class="card-footer py-2">
      <div class="d-flex justify-content-end">
        <small class="text-muted">By Xorg</small>
      </div>
    </div>
  </div>
 
  <button
    type="button"
    class="d-none"
    data-action="live#action"
    data-live-action-param="refresh"
    data-neox-crud-refresh-trigger
  ></button>
 
  <div class="modal fade" tabindex="-1" aria-hidden="true" data-neox-crud-modal-root>
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" data-neox-crud-modal-title></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" data-neox-crud-modal-body></div>
      </div>
    </div>
  </div>
 
  <script>
  (() => {
    const root = document.currentScript?.closest('[data-live-id]') || document.currentScript?.parentElement;
    if (!root) {
      return;
    }
 
    const modalRoot = root.querySelector('[data-neox-crud-modal-root]');
    if (!modalRoot) {
      return;
    }
 
    const modalBody = modalRoot.querySelector('[data-neox-crud-modal-body]');
    const modalTitle = modalRoot.querySelector('[data-neox-crud-modal-title]');
    const refreshTrigger = root.querySelector('[data-neox-crud-refresh-trigger]');
 
    const getModal = () => {
      if (!window.bootstrap || !window.bootstrap.Modal) {
        return null;
      }
      return window.bootstrap.Modal.getOrCreateInstance(modalRoot);
    };
 
    const setLoading = () => {
      modalBody.innerHTML = '<div class="py-5 text-center"><div class="spinner-border" role="status" aria-hidden="true"></div></div>';
    };
 
    const openUrl = async (url, title) => {
      modalTitle.textContent = title || '';
      setLoading();

      modalRoot.dataset.neoxCrudModalUrl = url;
 
      const m = getModal();
      if (m) {
        m.show();
      }
 
      const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      modalBody.innerHTML = await res.text();
    };
 
    root.addEventListener('click', (e) => {
      const a = e.target.closest('a[data-neox-crud-modal]');
      if (!a) return;
      e.preventDefault();
      openUrl(a.getAttribute('href'), a.dataset.neoxCrudModalTitle || a.getAttribute('title') || '');
    });
 
    modalRoot.addEventListener('submit', async (e) => {
      const form = e.target;
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.matches('[data-neox-crud-modal-form]')) return;
      e.preventDefault();
 
      const formActionAttr = form.getAttribute('action');
      const action = (formActionAttr && formActionAttr.trim() !== '')
        ? formActionAttr
        : (modalRoot.dataset.neoxCrudModalUrl || window.location.href);
      const method = (form.getAttribute('method') || 'POST').toUpperCase();
      const data = new FormData(form);
 
      const res = await fetch(action, {
        method,
        body: data,
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
      });
 
      const contentType = res.headers.get('content-type') || '';
      if (contentType.includes('application/json')) {
        const json = await res.json();
        if (json && json.success) {
          const m = getModal();
          if (m) {
            m.hide();
          }
          if (refreshTrigger) {
            refreshTrigger.click();
          }
          return;
        }
      }
 
      modalBody.innerHTML = await res.text();
    });

    root.addEventListener('submit', async (e) => {
      const form = e.target;
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.matches('form[data-neox-crud-ajax-delete]')) return;
      if (e.defaultPrevented) return;

      e.preventDefault();

      const action = form.getAttribute('action') || window.location.href;
      const method = (form.getAttribute('method') || 'POST').toUpperCase();
      const data = new FormData(form);

      const res = await fetch(action, {
        method,
        body: data,
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
      });

      const contentType = res.headers.get('content-type') || '';
      if (contentType.includes('application/json')) {
        const json = await res.json();
        if (json && json.success) {
          if (refreshTrigger) {
            refreshTrigger.click();
          }
          return;
        }
      }

      window.location.reload();
    });
  })();
  </script>
</div>

