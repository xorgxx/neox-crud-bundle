{% extends base_layout %}

{% set content_block = content_block|default('content') %}

{% block neox_crud_content %}
  <div class="container">
    {{ component('neox_crud_index_table', { resource: resource }) }}
  </div>
{% endblock %}

{% block admin_content %}
  {% if content_block == 'admin_content' %}
    {{ block('neox_crud_content') }}
  {% endif %}
{% endblock %}

{% block body %}
  {% if content_block == 'body' %}
    {{ block('neox_crud_content') }}
  {% endif %}
{% endblock %}

{% block content %}
  {% if content_block == 'content' %}
    {{ block('neox_crud_content') }}
  {% endif %}
{% endblock %}
