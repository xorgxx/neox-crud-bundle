{% form_theme form '@NeoxCrud/form/neox_crud_form_theme.html.twig' %}

{% set __is_edit = entity is defined and attribute(entity, 'id') is not null %}

{% set __title_key = resource ~ '.title.' ~ (__is_edit ? 'edit' : 'new') %}
{% set __title_val = __title_key|trans({}, resource) %}

<h1 class="h5 mb-3">
  {{ __title_val != __title_key ? __title_val : (__is_edit ? 'Modifier' : 'Nouveau') }}
</h1>

{{ form_start(form, { action: app.request.uri, attr: { 'data-neox-crud-modal-form': '1' } }) }}
  {% for child in form %}
    {% set is_collection = child.vars.block_prefixes is defined and 'collection' in child.vars.block_prefixes %}
    {% set has_live_attr = child.vars.attr is defined and child.vars.attr['data-neox-live-collection'] is defined %}
    {% set has_live_row_attr = child.vars.row_attr is defined and child.vars.row_attr['data-neox-live-collection'] is defined %}
    {% set is_live_collection = is_collection and (has_live_attr or has_live_row_attr) %}

    {% if is_collection %}
      <div class="mb-3 text-start">
        {{ form_label(child) }}
        {{ form_errors(child) }}
        {% if is_live_collection %}
          {{ component('neox_crud.collection_live', { resource: resource, entityId: entity.id, fieldName: child.vars.name }) }}
          {% do child.setRendered() %}
        {% else %}
          <div class="collection-container">
            {{ form_widget(child) }}
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="mb-3 text-start">
        {{ form_label(child) }}
        {{ form_widget(child) }}
        {{ form_errors(child) }}
      </div>
    {% endif %}
  {% endfor %}

  <button class="btn btn-primary">Enregistrer</button>
{{ form_end(form) }}
